<Window x:Class="BikeRentalOpdracht.View.StoresEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BikeRentalOpdracht.View"
        mc:Ignorable="d"
        Title="StoresEdit" Height="480" Width="800">
    <Grid Background="#FFCED0DC">
        <DataGrid ItemsSource="{Binding Stores}" SelectedItem="{Binding SelectedStore}" Margin="0,0,-0.2,70.4"/>
        <Button Content="Change Store" Command="{Binding ChangeStoreClick}" HorizontalAlignment="Left" Margin="10,415,0,0" VerticalAlignment="Top" Width="95"/>
        <Button Content="Delete" Command="{Binding DeleteClick}" HorizontalAlignment="Left" Margin="135,415,0,0" VerticalAlignment="Top" Width="75"/>

    </Grid>
</Window>
