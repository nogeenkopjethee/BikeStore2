<Window x:Class="BikeRentalOpdracht.View.StoresEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BikeRentalOpdracht.View"
        mc:Ignorable="d"
        Title="StoresEdit" Height="331.661" Width="355.294">
    <Grid>
        <Button Content="Change Store" Command="{Binding ChangeStoreClick}" HorizontalAlignment="Left" Margin="10,255,0,0" VerticalAlignment="Top" Width="95"/>
        <Button Content="Delete" Command="{Binding DeleteClick}" HorizontalAlignment="Left" Margin="140,255,0,0" VerticalAlignment="Top" Width="75"/>
        <ListBox Margin="30,60,170,76" ItemsSource="{Binding SelectedStore.Bikes}" DisplayMemberPath="Brand"/>
        <ComboBox HorizontalAlignment="Left" Margin="201,10,0,0" VerticalAlignment="Top" Width="120" ItemsSource="{Binding Stores}" SelectedItem="{Binding SelectedStore}" DisplayMemberPath="Name" />

    </Grid>
</Window>
