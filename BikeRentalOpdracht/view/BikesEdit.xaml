<Window x:Class="BikeRentalOpdracht.View.BikesEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BikeRentalOpdracht.View"
        mc:Ignorable="d"
        Title="BikesEdit" Height="331.661" Width="355.294">
    <Grid>
        <DataGrid ItemsSource="{Binding Bikes}" SelectedItem="{Binding SelectedBike}" Margin="0,0,-0.2,70.4" />
        <Button Content="Change Bike" Command="{Binding ChangeBikeClick}" HorizontalAlignment="Left" Margin="10,255,0,0" VerticalAlignment="Top" Width="95"/>
        <Button Content="Delete" Command="{Binding DeleteClick}" HorizontalAlignment="Left" Margin="140,255,0,0" VerticalAlignment="Top" Width="75"/>
    </Grid>
</Window>